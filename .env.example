# Copia este archivo a .env.local y rellena los valores. .env.local nunca se
# versiona (regla invariable 8); este archivo solo lleva los NOMBRES.

# Neon — cadena pooled, la que usa la app en runtime.
DATABASE_URL=
# Neon — conexión DIRECTA (sin -pooler), solo para migraciones. drizzle.config.ts
# la prefiere si existe; migrar por el pooler da errores raros en drizzle-kit.
DATABASE_URL_DIRECT=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Decolecta — consulta de RUC en SUNAT (módulo Clientes, modules/clientes/decolecta.ts).
# Solo servidor: no lleva prefijo NEXT_PUBLIC_ y nunca debe llevarlo.
DECOLECTA_API_KEY=

# TEMPORAL — correos (separados por comas) a los que se les oculta el grupo CRM
# mientras está en construcción. Vacía = todos lo ven. Se retira al aprobarse
# el CRM (ver AGENTS.md, "Excepción en curso — CRM").
CRM_OCULTO_PARA=
